<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:Style src="Styles/GameStyles.uss" />
    <ui:VisualElement name="root" class="screen" style="flex-direction: column;">

        <!-- HEADER: P1 Score | Timer | P2 Score -->
        <ui:VisualElement name="header" class="header">
            <ui:VisualElement style="flex-direction: row; align-items: center; flex: 1;">
                <ui:Label name="p1-name" text="P1 · TETRIS" class="text-xs text--sub" style="margin-right: 12px;"/>
                <ui:Label name="p1-score" text="0" class="text-lg text--p1"/>
            </ui:VisualElement>

            <ui:VisualElement style="flex-direction: column; align-items: center;">
                <ui:Label text="TIME" class="text-xs text--sub"/>
                <ui:Label name="timer" text="02:47" class="header__timer"/>
            </ui:VisualElement>

            <ui:VisualElement style="flex-direction: row; align-items: center; justify-content: flex-end; flex: 1;">
                <ui:Label name="p2-score" text="0" class="text-lg text--p2"/>
                <ui:Label name="p2-name" text="CHARACTER · P2" class="text-xs text--sub" style="margin-left: 12px;"/>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- BODY: P1 Panel | Board | P2 Panel -->
        <ui:VisualElement name="body" style="flex-direction: row; flex-grow: 1;">

            <!-- P1 LEFT PANEL -->
            <ui:VisualElement name="panel-p1" class="panel panel--p1"
                style="width: 200px; flex-direction: column; margin: 8px;">

                <!-- Next Piece -->
                <ui:Label text="NEXT" class="text-xs text--sub" style="margin-bottom: 4px;"/>
                <ui:VisualElement name="next-piece-container"
                    style="width: 128px; height: 128px; background-color: #1E1E35;
                           border-color: #2A2A4A; border-width: 1px; border-radius: 4px;
                           margin-bottom: 12px;"/>

                <ui:VisualElement class="divider"/>

                <!-- Статистика -->
                <ui:Label text="СТАТИСТИКА" class="text-xs text--sub" style="margin-bottom: 8px;"/>
                <ui:VisualElement class="stat-row">
                    <ui:Label text="LINES" class="text-xs text--sub"/>
                    <ui:Label name="stat-lines" text="0" class="stat-value text--p1"/>
                </ui:VisualElement>
                <ui:VisualElement class="stat-row">
                    <ui:Label text="LEVEL" class="text-xs text--sub"/>
                    <ui:Label name="stat-level" text="1" class="stat-value text--p1"/>
                </ui:VisualElement>
                <ui:VisualElement class="stat-row">
                    <ui:Label text="PIECES" class="text-xs text--sub"/>
                    <ui:Label name="stat-pieces" text="0" class="stat-value text--p1"/>
                </ui:VisualElement>

                <ui:VisualElement class="divider"/>

                <!-- Controls -->
                <ui:Label text="CONTROLS" class="text-xs text--sub" style="margin-bottom: 6px;"/>
                <ui:Label text="Move    ← →"    class="text-xs"/>
                <ui:Label text="Rotate    ↑"    class="text-xs"/>
                <ui:Label text="Soft Drop  ↓"  class="text-xs"/>
                <ui:Label text="Hard Drop  Space" class="text-xs"/>

            </ui:VisualElement>

            <!-- CENTER — игровое поле (пустое место) -->
            <ui:VisualElement name="board-area" style="flex-grow: 1;"/>

            <!-- P2 RIGHT PANEL -->
            <ui:VisualElement name="panel-p2" class="panel panel--p2"
                style="width: 200px; flex-direction: column; margin: 8px;">

                <!-- Lines / Level -->
                <ui:VisualElement class="stat-row">
                    <ui:Label text="LINES" class="text-xs text--sub"/>
                    <ui:Label name="p2-lines" text="0" class="stat-value text--p2"/>
                </ui:VisualElement>
                <ui:VisualElement class="stat-row">
                    <ui:Label text="LEVEL" class="text-xs text--sub"/>
                    <ui:Label name="p2-level" text="1" class="stat-value text--p2"/>
                </ui:VisualElement>

                <ui:VisualElement class="divider"/>

                <!-- Cooldowns -->
                <ui:Label text="COOLDOWN" class="text-xs text--sub" style="margin-bottom: 8px;"/>

                <!-- Push -->
                <ui:VisualElement class="cooldown-row">
                    <ui:Label text="PUSH  ↑" class="cooldown-row__label"/>
                    <ui:VisualElement class="cooldown-row__bar">
                        <ui:VisualElement name="push-fill" class="cooldown-row__fill" style="width: 100%;"/>
                    </ui:VisualElement>
                    <ui:Label name="push-time" text="ГОТОВО" class="cooldown-row__time text--ready"/>
                </ui:VisualElement>

                <!-- Destroy Side -->
                <ui:VisualElement class="cooldown-row">
                    <ui:Label text="SIDE  ↔" class="cooldown-row__label"/>
                    <ui:VisualElement class="cooldown-row__bar">
                        <ui:VisualElement name="side-fill" class="cooldown-row__fill" style="width: 100%;"/>
                    </ui:VisualElement>
                    <ui:Label name="side-time" text="ГОТОВО" class="cooldown-row__time text--ready"/>
                </ui:VisualElement>

                <!-- Destroy Down -->
                <ui:VisualElement class="cooldown-row">
                    <ui:Label text="DOWN  ↓" class="cooldown-row__label"/>
                    <ui:VisualElement class="cooldown-row__bar">
                        <ui:VisualElement name="down-fill" class="cooldown-row__fill" style="width: 100%;"/>
                    </ui:VisualElement>
                    <ui:Label name="down-time" text="ГОТОВО" class="cooldown-row__time text--ready"/>
                </ui:VisualElement>

                <ui:VisualElement class="divider"/>

                <!-- Exit -->
                <ui:Label text="EXIT" class="text-xs text--sub" style="margin-bottom: 4px;"/>
                <ui:VisualElement name="exit-open" class="exit-row exit-row--open">
                    <ui:Label text="🚪" style="font-size: 24px; margin-right: 8px;"/>
                    <ui:VisualElement style="flex-direction: column;">
                        <ui:Label text="OPEN" class="text-sm text--ready"/>
                        <ui:Label text="E / Enter" class="text-xs text--sub"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="exit-blocked" class="exit-row exit-row--blocked"
                    style="display: none;">
                    <ui:Label text="🔒" style="font-size: 24px; margin-right: 8px;"/>
                    <ui:Label text="BLOCKED" class="text-sm text--danger"/>
                </ui:VisualElement>

            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
