<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Style src="Styles/GameStyles.uss" />

    <ui:VisualElement name="menu-root" class="screen"
        style="align-items:center; justify-content:center;">

        <!-- Заголовок TETRIS vs CHARACTER -->
        <ui:VisualElement style="flex-direction:row; align-items:baseline; margin-bottom:8px;">
            <ui:Label text="TETRIS" class="text-xl text--p1"
                style="letter-spacing:4px;"/>
            <ui:Label text=" vs " class="text-md text--sub"
                style="margin: 0 8px;"/>
            <ui:Label text="CHARACTER" class="text-xl text--p2"
                style="letter-spacing:4px;"/>
        </ui:VisualElement>

        <!-- Подзаголовок -->
        <ui:Label text="Асимметричная битва · 2 игрока"
            class="text-sm text--sub" style="margin-bottom: 48px;"/>

        <!-- Панель с кнопками -->
        <ui:VisualElement class="panel--menu">
            <ui:Button name="btn-play"     text="ИГРАТЬ"     class="btn btn--primary" style="width:240px;"/>
            <ui:Button name="btn-lobby"    text="ЛОББИ"      class="btn btn--primary" style="width:240px;"/>
            <ui:Button name="btn-settings" text="НАСТРОЙКИ"  class="btn btn--primary" style="width:240px;"/>
            <ui:Button name="btn-quit"     text="ВЫЙТИ"      class="btn btn--danger"  style="width:240px;"/>
        </ui:VisualElement>

        <!-- Версия -->
        <ui:Label name="version-label" text="v0.3.0  Unity 2022  Photon PUN2"
            class="text-xs text--sub"
            style="position:absolute; bottom:16px;"/>

    </ui:VisualElement>
</ui:UXML>
