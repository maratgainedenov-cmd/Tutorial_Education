<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Style src="Styles/GameStyles.uss" />

    <!-- Тёмный фон -->
    <ui:VisualElement name="overlay-bg"
        style="width:100%; height:100%; background-color:rgba(10,10,20,0.85);
               align-items:center; justify-content:center;">

        <!-- Карточка результата -->
        <ui:VisualElement name="result-card" class="panel--overlay panel--victory">

            <!-- ПОБЕДА! -->
            <ui:Label name="result-title" text="ПОБЕДА!" class="text-xl text--p2"
                style="margin-bottom: 4px;"/>

            <!-- Player X Wins -->
            <ui:Label name="result-subtitle" text="Player 2 Wins" class="text-sm text--sub"
                style="margin-bottom: 16px;"/>

            <!-- Разделитель -->
            <ui:VisualElement style="width:100%; height:1px; background-color:#2A2A4A; margin-bottom:16px;"/>

            <!-- Описание -->
            <ui:Label name="result-description" text="Персонаж добрался до выхода."
                class="text-sm" style="margin-bottom: 24px; -unity-text-align: middle-center;"/>

            <!-- Кнопки -->
            <ui:Button name="btn-restart" text="СЫГРАТЬ СНОВА" class="btn btn--primary"
                style="width: 240px;"/>
            <ui:Button name="btn-menu"    text="В ГЛАВНОЕ МЕНЮ" class="btn btn--danger"
                style="width: 240px;"/>

        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
