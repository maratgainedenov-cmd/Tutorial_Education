/* ── Переменные ─────────────────────────────────────────── */
:root {
    --color-bg:           #0A0A14;
    --color-panel:        #12121F;
    --color-panel-mid:    #1E1E35;
    --color-border:       #2A2A4A;
    --color-text:         #E8E8F0;
    --color-text-sub:     #8888AA;
    --color-p1:           #4A9EFF;
    --color-p2:           #FF7A3D;
    --color-success:      #40D080;
    --color-danger:       #FF3A3A;
    --color-ready:        #80FFB0;
    --color-cooldown:     #6060AA;
}

.screen {
    width: 100%;
    height: 100%;
    background-color: #0A0A14;
}

/* ── Панели ──────────────────────────────────────────────── */
.panel {
    background-color: #12121F;
    border-color: #2A2A4A;
    border-width: 1px;
    border-radius: 4px;
    padding: 12px;
}
.panel--p1 { border-top-color: #4A9EFF; border-top-width: 2px; }
.panel--p2 { border-top-color: #FF7A3D; border-top-width: 2px; }

.panel--overlay {
    background-color: #12121F;
    border-width: 2px;
    border-radius: 4px;
    padding: 32px;
    min-width: 400px;
    align-items: center;
}
.panel--victory { border-color: #FF7A3D; }
.panel--defeat  { border-color: #4A9EFF; }

.panel--menu {
    background-color: #1E1E35;
    border-color: #4A9EFF;
    border-width: 1px;
    border-radius: 4px;
    padding: 40px;
    align-items: center;
    min-width: 320px;
}

/* ── Типографика ─────────────────────────────────────────── */
.text-xl { font-size: 72px; -unity-font-style: bold; color: #E8E8F0; }
.text-lg { font-size: 48px; -unity-font-style: bold; color: #E8E8F0; }
.text-md { font-size: 32px; -unity-font-style: bold; color: #E8E8F0; }
.text-sm { font-size: 24px; color: #E8E8F0; }
.text-xs { font-size: 18px; color: #8888AA; }

.text--p1     { color: #4A9EFF; }
.text--p2     { color: #FF7A3D; }
.text--ready  { color: #80FFB0; }
.text--cool   { color: #6060AA; }
.text--danger { color: #FF3A3A; }
.text--sub    { color: #8888AA; }
.text--warn   { color: #FFB020; }

/* ── Кнопки ──────────────────────────────────────────────── */
.btn {
    height: 48px;
    min-width: 200px;
    border-radius: 4px;
    border-width: 1px;
    margin-top: 8px;
    padding-left: 24px;
    padding-right: 24px;
    font-size: 24px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    cursor: link;
}
.btn--primary {
    background-color: rgba(74, 158, 255, 0.15);
    border-color: #4A9EFF;
    color: #E8E8F0;
}
.btn--primary:hover {
    background-color: rgba(74, 158, 255, 0.35);
    color: #F0C419;
    border-color: #7DBAFF;
}
.btn--primary:active { scale: 0.95 0.95; }
.btn--danger {
    background-color: rgba(255, 58, 58, 0.15);
    border-color: #FF3A3A;
    color: #E8E8F0;
}
.btn--danger:hover { background-color: rgba(255, 58, 58, 0.35); }

/* ── Header ──────────────────────────────────────────────── */
.header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 8px 16px;
    background-color: #12121F;
    border-bottom-color: #2A2A4A;
    border-bottom-width: 1px;
    height: 64px;
}
.header__timer {
    font-size: 48px;
    -unity-font-style: bold;
    color: #E8E8F0;
    -unity-text-align: middle-center;
}

/* ── Cooldown ────────────────────────────────────────────── */
.cooldown-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
    height: 44px;
}
.cooldown-row__label { font-size: 18px; color: #8888AA; width: 120px; }
.cooldown-row__bar {
    flex-grow: 1;
    height: 8px;
    background-color: #1E1E35;
    border-radius: 4px;
    margin: 0 8px;
}
.cooldown-row__fill { height: 8px; border-radius: 4px; background-color: #80FFB0; }
.cooldown-row__fill--cd { background-color: #6060AA; }
.cooldown-row__time { font-size: 18px; color: #8888AA; width: 50px; -unity-text-align: middle-right; }

/* ── Exit ────────────────────────────────────────────────── */
.exit-row {
    flex-direction: row;
    align-items: center;
    padding: 8px;
    border-radius: 4px;
    border-width: 1px;
    margin-top: 8px;
}
.exit-row--open    { border-color: #40D080; background-color: rgba(64,208,128,0.1); }
.exit-row--blocked { border-color: #FF3A3A; background-color: rgba(255,58,58,0.1); }

/* ── Stat ────────────────────────────────────────────────── */
.stat-row {
    flex-direction: row;
    justify-content: space-between;
    padding: 4px 0;
    border-bottom-color: #2A2A4A;
    border-bottom-width: 1px;
    margin-bottom: 4px;
}
.stat-value { font-size: 32px; -unity-font-style: bold; color: #E8E8F0; }

.divider { height: 1px; background-color: #2A2A4A; margin: 12px 0; }
